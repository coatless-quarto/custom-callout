{
  "Custom Callout Block": {
    "prefix": "callout",
    "body": [
      "::: {.${1:callout-type}}",
      "$0",
      ":::"
    ],
    "description": "Insert a custom callout block."
  },
  "Custom Callout with Title": {
    "prefix": "callout-title",
    "body": [
      "::: {.${1:callout-type}}",
      "",
      "## ${2:Title}",
      "",
      "$0",
      "",
      ":::"
    ],
    "description": "Insert a custom callout block with a title."
  }
}
